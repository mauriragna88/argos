{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arnes.dev/schemas/sam-digest-v1.json",
  "title": "Sam Digest — Cross-Quest Memory Bridge",
  "description": "Generated by Sam at TURN 7 after each quest. Atlas reads this at TURN 0.5 before Party Select. This is the formal hand-off from quest N to quest N+1, fixing the Inter-Quest Forgetting and Atlas Blind Spot problems.",
  "type": "object",
  "required": ["schema", "generated_at", "generated_after_quest", "top_recommendations", "agent_trust_scores", "lessons_from_last_quest"],
  "properties": {
    "schema": { "type": "string", "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "generated_after_quest": { "type": "string", "pattern": "^Q-[A-Z0-9-]+$" },
    "atlas_read_before_quest": { "type": "string", "description": "Quest ID that Atlas should read this before" },
    "top_recommendations": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["priority", "recommendation", "based_on"],
        "properties": {
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
          "recommendation": { "type": "string", "maxLength": 500 },
          "based_on": { "type": "array", "items": { "type": "string" }, "description": "References to blackboard pattern IDs" },
          "expires_after_quest": { "type": ["string", "null"] },
          "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] }
        }
      }
    },
    "agent_trust_scores": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "trend": { "type": "string", "enum": ["rising", "falling", "stable", "n/a"] }
        }
      }
    },
    "risk_alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["alert", "severity"],
        "properties": {
          "alert": { "type": "string", "maxLength": 500 },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "agent": { "type": "string" },
          "action": { "type": "string" }
        }
      }
    },
    "lessons_from_last_quest": {
      "type": "array",
      "items": { "type": "string", "maxLength": 300 }
    },
    "party_config_recommendation": {
      "type": "object",
      "properties": {
        "for_quest_type": { "type": "string" },
        "recommended_party": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string" },
        "historical_success_rate": { "type": "number" }
      }
    },
    "anti_repetition_warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "warning": { "type": "string" },
          "agent": { "type": "string" },
          "past_quest": { "type": "string" },
          "what_to_avoid": { "type": "string" },
          "what_to_try_instead": { "type": "string" }
        }
      }
    }
  }
}