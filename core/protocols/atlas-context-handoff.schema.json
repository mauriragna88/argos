{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://arnes.local/schemas/atlas-context-handoff-1.0.json",
  "title":"Atlas role-scoped hand-off",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","type","handoff_id","from_role","to_role","quest","objective","dependency_status","context_scope","evidence_refs","model_attribution","next_action"],
  "properties":{
    "schema_version":{"const":"1.0"}, "type":{"const":"atlas_context_handoff"},
    "handoff_id":{"type":"string","pattern":"^H-[A-Za-z0-9][A-Za-z0-9._-]*$"}, "from_role":{"$ref":"#/$defs/role"}, "to_role":{"$ref":"#/$defs/role"},
    "quest":{"$ref":"#/$defs/quest"}, "objective":{"type":"string","minLength":1,"maxLength":2000}, "dependency_status":{"type":"array","items":{"$ref":"#/$defs/dependency"}},
    "context_scope":{"type":"object","additionalProperties":false,"required":["summary","included_sections","memory_refs","full_history_included"],"properties":{"summary":{"type":"string","maxLength":4000},"included_sections":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["objective","acceptance_criteria","dependencies","evidence","remediation","historical_lessons","route"]}},"memory_refs":{"type":"array","items":{"$ref":"#/$defs/correlatedRef"}},"full_history_included":{"const":false}}},
    "evidence_refs":{"type":"array","items":{"$ref":"#/$defs/artifactRef"}},
    "model_attribution":{"type":"object","additionalProperties":false,"required":["agent","provider","model","route_reason","quest_id","attempt_id"],"properties":{"agent":{"type":"string","minLength":1},"provider":{"type":"string","minLength":1},"model":{"type":"string","minLength":1},"route_reason":{"type":"string","minLength":1},"quest_id":{"type":"string","pattern":"^Q-[0-9]{3,}$"},"attempt_id":{"type":"string","pattern":"^A-[0-9]{3,}$"},"request_ref":{"type":"string"}}},
    "next_action":{"type":"object","additionalProperties":false,"required":["owner","action","success_criteria"],"properties":{"owner":{"$ref":"#/$defs/role"},"action":{"type":"string","minLength":1,"maxLength":2000},"success_criteria":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}}},
    "audit":{"type":"object","additionalProperties":false,"required":["verdict_status","verdict_ref","remediation_ref"],"properties":{"verdict_status":{"enum":["PASS","FAIL_PARTIAL","FAIL_TOTAL"]},"verdict_ref":{"$ref":"#/$defs/correlatedRef"},"remediation_ref":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/correlatedRef"}]}}}
  },
  "allOf":[
    {"anyOf":[
      {"properties":{"from_role":{"const":"atlas"},"to_role":{"const":"executor"}}},
      {"properties":{"from_role":{"const":"executor"},"to_role":{"const":"varys"}}},
      {"properties":{"from_role":{"const":"varys"},"to_role":{"const":"tywin"}}},
      {"properties":{"from_role":{"const":"tywin"},"to_role":{"const":"sam"}}},
      {"properties":{"from_role":{"const":"sam"},"to_role":{"const":"atlas"}}}
    ]},
    {"if":{"properties":{"to_role":{"const":"executor"}}},"then":{"properties":{"context_scope":{"properties":{"included_sections":{"items":{"enum":["objective","acceptance_criteria","dependencies","route"]}}}}}}},
    {"if":{"properties":{"to_role":{"const":"varys"}}},"then":{"properties":{"context_scope":{"properties":{"included_sections":{"items":{"enum":["objective","acceptance_criteria","dependencies","evidence"]}}}}}}},
    {
      "if":{"properties":{"to_role":{"const":"tywin"}}},
      "then":{"properties":{
        "context_scope":{"properties":{"included_sections":{"items":{"enum":["acceptance_criteria","evidence","remediation"]},"contains":{"const":"evidence"}}}},
        "evidence_refs":{"contains":{"properties":{"kind":{"const":"evidence_pack"}},"required":["kind"]},"minContains":1,"maxContains":1}
      }}
    },
    {
      "if":{"properties":{"to_role":{"const":"sam"}}},
      "then":{"required":["audit"],"properties":{
        "context_scope":{"properties":{"included_sections":{"items":{"enum":["evidence","remediation","historical_lessons"]},"contains":{"const":"evidence"}}}},
        "evidence_refs":{"contains":{"properties":{"kind":{"const":"verdict"}},"required":["kind"]},"minContains":1,"maxContains":1}
      }}
    },
    {
      "if":{"properties":{"audit":{"properties":{"verdict_status":{"enum":["FAIL_PARTIAL","FAIL_TOTAL"]}},"required":["verdict_status"]}}},
      "then":{"properties":{
        "audit":{"properties":{"remediation_ref":{"$ref":"#/$defs/correlatedRef"}},"required":["remediation_ref"]},
        "evidence_refs":{"contains":{"properties":{"kind":{"const":"remediation_brief"}},"required":["kind"]},"minContains":1,"maxContains":1}
      }}
    }
  ],
  "$defs":{
    "role":{"enum":["atlas","executor","varys","tywin","sam"]},
    "quest":{"type":"object","additionalProperties":false,"required":["quest_id","attempt_id","status"],"properties":{"quest_id":{"type":"string","pattern":"^Q-[0-9]{3,}$"},"attempt_id":{"type":"string","pattern":"^A-[0-9]{3,}$"},"status":{"enum":["planned","in_progress","awaiting_evidence","auditing","advising","decision_pending","retrying","paused","completed"]}}},
    "correlatedRef":{"type":"object","additionalProperties":false,"required":["path_or_id","quest_id","attempt_id"],"properties":{"path_or_id":{"type":"string","minLength":1},"quest_id":{"type":"string","pattern":"^Q-[0-9]{3,}$"},"attempt_id":{"type":"string","pattern":"^A-[0-9]{3,}$"}}},
    "artifactRef":{"type":"object","additionalProperties":false,"required":["kind","path_or_id","quest_id","attempt_id"],"properties":{"kind":{"enum":["evidence_pack","audit_request","verdict","remediation_brief","sam_counsel","atlas_decision","command_output","diff","memory"]},"path_or_id":{"type":"string","minLength":1},"quest_id":{"type":"string","pattern":"^Q-[0-9]{3,}$"},"attempt_id":{"type":"string","pattern":"^A-[0-9]{3,}$"},"integrity_ref":{"type":"string"}}},
    "dependency":{"type":"object","additionalProperties":false,"required":["id","status","blocking"],"properties":{"id":{"type":"string","minLength":1},"status":{"enum":["not_started","in_progress","satisfied","blocked","failed"]},"blocking":{"type":"boolean"},"evidence_ref":{"$ref":"#/$defs/correlatedRef"}}}
  }
}
