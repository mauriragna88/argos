{
  "_comment": "Claude desktop config para Atlas RPG. POLITICA DEL USUARIO (2026-08-16): plataforma Claude DESHABILITADA. Solo se trabaja con deepseek-v4-flash. Esta config queda como referencia historica.",
  "mcpServers": {
    "atlas-rpg": {
      "command": "node",
      "args": ["./cli/arnes-mcp-bridge.js"],
      "env": {
        "HARNESS_RPG_MODE": "true",
        "HARNESS_PARTY_FILE": ".arnes/config.json"
      }
    }
  },
  "agents": {
    "atlas": {
      "model": "deepseek-v4-flash",
      "system_prompt_file": "core/atlas-player.agent.md",
      "role": "primary"
    },
    "vivi": {
      "model": "deepseek-v4-flash",
      "system_prompt_file": "core/classes/vivi.agent.md",
      "role": "subagent",
      "category": "visual-engineering"
    },
    "paladin": {
      "model": "deepseek-v4-flash",
      "system_prompt_file": "core/classes/paladin.agent.md",
      "role": "subagent",
      "category": "backend"
    },
    "rogue": {
      "model": "deepseek-v4-flash",
      "system_prompt_file": "core/classes/rogue.agent.md",
      "role": "subagent",
      "category": "qa"
    },
    "eiko": {
      "model": "deepseek-v4-flash",
      "system_prompt_file": "core/classes/eiko.agent.md",
      "role": "subagent",
      "category": "devops"
    },
    "monk": {
      "model": "deepseek-v4-flash",
      "system_prompt_file": "core/classes/monk.agent.md",
      "role": "subagent",
      "category": "architecture"
    },
    "ranger": {
      "model": "deepseek-v4-flash",
      "system_prompt_file": "core/classes/ranger.agent.md",
      "role": "subagent",
      "category": "research"
    }
  },
  "auto_loop": true,
  "circuit_breaker": {
    "threshold": 3,
    "window_minutes": 60,
    "cooldown_minutes": 30
  }
}