# ARGOS - Git Ignore
# Protege secretos y artefactos locales del harness. La memoria vive en .arnes/ (repo OSMA: osma_brain.py)

# ===== Secretos y configuracion local =====
.arnes/config.json
.arnes/arnes.db
.arnes/connections.json
.arnes/connections*.json
.arnes/project.json
.arnes/*.bak.*
.env
.env.*
*.local

# ===== Artefactos del harness (regenerables) =====
.arnes/memory/export/
.arnes/loop-state.json
.arnes/circuit-breaker.json
.arnes/backups/
.arnes/triage-log.jsonl
.arnes/model-runs.jsonl
.arnes/loop-attempts.jsonl
.arnes/loop-contracts/
.arnes/regressions.jsonl

# ===== Skills externas instaladas (regenerables via skills-lock.json / argos skills add) =====
.agents/skills/
.claude/skills/

# ===== Credenciales OpenCode =====
~/.config/opencode/auth.json
auth.json

# ===== Node =====
node_modules/
dist/
build/
.next/
out/
coverage/

# ===== Python =====
__pycache__/
*.pyc
*.pyo

# ===== Basura del sistema =====
Thumbs.db
Desktop.ini
*.log
.DS_Store

# ===== Archivos temporales =====
*.tmp
*.temp
*~

