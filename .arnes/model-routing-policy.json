  "stuck_agent_rule": {
    "trigger": "agente no avanza / se estanca / error repetido",
    "timeout_per_agent_min": 5,
    "on_timeout": "switch_to_next_preference",
    "on_error_429_401_410": "switch_to_next_preference_inmediato",
    "max_failures_before_switch": 3,
    "window_minutes": 60,
    "cooldown_minutes": 30,
    "note": "Si un agente se estanca mas de 5 min o falla 3 veces, Atlas brinca al siguiente modelo en preference_order. NVIDIA se agota -> DeepSeek OpenCode Go."
  },
